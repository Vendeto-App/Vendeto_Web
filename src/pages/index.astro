---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import WhyVendeto from '../components/WhyVendeto.astro';
import Comparison from '../components/Comparison.astro';
import Pricing from '../components/Pricing.astro';
import Complementos from '../components/Complementos.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Vendeto — Punto de venta para tu comercio" description="Sistema de punto de venta para comercios minoristas: ventas, stock, clientes, cajas y deudas en un solo lugar.">
  <Header />
  <main>
    <Hero />
    <Features />
    <WhyVendeto />
    <Comparison />
    <Pricing />
    <Complementos />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
