---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const licenseKey = Astro.url.searchParams.get('license_key') ?? '';
---
<BaseLayout title="Pago exitoso — Vendeto" description="Tu licencia quedó asociada a tu email. Activá Vendeto en tu computadora.">
  <Header />
  <main>
    <section class="result-section">
      <div class="result-card success">
        <div class="icon">&#10003;</div>
        <h1 id="resultTitle">Pago exitoso</h1>
        <p id="resultText">Tu licencia quedó asociada a tu email. Ahora activala en Vendeto.</p>
        <script is:inline>
          (function () {
            if (new URLSearchParams(location.search).get('modo') !== 'suscripcion') return;
            var title = document.getElementById('resultTitle');
            var text = document.getElementById('resultText');
            if (title) title.textContent = 'Débito automático activado';
            if (text) text.textContent = 'Te vamos a cobrar cada mes con tu tarjeta. Lo podés cancelar cuando quieras desde tu cuenta de Mercado Pago, en Suscripciones.';
          })();
        </script>
        {licenseKey && (
          <div class="license-box">
            <span class="license-label">Tu clave de licencia</span>
            <code>{licenseKey}</code>
          </div>
        )}
        <div class="instructions">
          <h2>Instrucciones</h2>
          <ol>
            <li>Descargá e instalá Vendeto en tu computadora</li>
            <li>Registrate con el mismo email con el que pagaste (te da una prueba de 30 días)</li>
            <li>Si ya tenés cuenta, ingresá a Configuración y tocá "Buscar licencia"</li>
          </ol>
        </div>
        <a href="/api/latest?download=1" class="btn btn-primary">Descargar Vendeto</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .result-section { padding: 96px 0; background: var(--bg-alt); min-height: 60vh; }
  .result-card {
    background: var(--surface);
    border-radius: 14px;
    padding: 48px 32px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }
  .icon { font-size: 2.5rem; margin-bottom: 16px; color: var(--ok); }
  .result-card h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; }
  .result-card p { color: var(--text-2); margin-bottom: 24px; }
  .license-box { margin: 24px 0; }
  .license-label { display: block; font-size: 0.8rem; color: var(--text-2); margin-bottom: 8px; }
  .license-box code {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 1rem;
    letter-spacing: 0.05em;
    word-break: break-all;
  }
  .instructions { text-align: left; margin: 24px 0; }
  .instructions h2 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
  .instructions ol { padding-left: 20px; color: var(--text-2); font-size: 0.9rem; }
  .instructions li { padding: 4px 0; }
</style>
