---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
const planParam = (Astro.url.searchParams.get('plan') ?? '').toLowerCase();
const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
const DEFAULT_MONTHS = 12;
const DEFAULT_FACTOR = 0.8;
const plans = [
  {
    name: 'Básico',
    key: 'basica',
    tag: 'El más elegido',
    monthly: 32500,
    price: `$${fmt.format(Math.round(32500 * DEFAULT_MONTHS * DEFAULT_FACTOR))}`,
    original: `$${fmt.format(32500 * DEFAULT_MONTHS)}`,
    per: `por ${DEFAULT_MONTHS} meses`,
    desc: 'Para comercios que arrancan y necesitan todas las funciones.',
    features: [
      { strong: 'Hasta 3 usuarios', text: ' trabajando en equipo' },
      { strong: 'Hasta 1.000 productos', text: ' en catálogo' },
      { text: 'Todos los módulos activados' },
      { text: 'Soporte por email y WhatsApp' },
    ],
    cta: 'Contratar Básico',
    featured: false,
  },
  {
    name: 'Avanzado',
    key: 'maxima',
    tag: 'El más completo',
    monthly: 39990,
    price: `$${fmt.format(Math.round(39990 * DEFAULT_MONTHS * DEFAULT_FACTOR))}`,
    original: `$${fmt.format(39990 * DEFAULT_MONTHS)}`,
    per: `por ${DEFAULT_MONTHS} meses`,
    desc: 'Todo el poder de Vendeto, sin límites de usuarios ni de productos.',
    features: [
      { strong: 'Usuarios ilimitados' },
      { strong: 'Hasta 10.000 productos', text: ' en catálogo' },
      { text: 'Verificación instantánea de pagos con Mercado Pago' },
      { text: 'Soporte prioritario por email y WhatsApp' },
    ],
    cta: 'Contratar Avanzado',
    featured: true,
  },
];
const highlighted = plans.find((p) => p.key === planParam)?.key ?? 'maxima';
---
<BaseLayout
  title="Licencias extendidas — Vendeto"
  description="Comprá 6, 12 o 36 meses de Vendeto en un solo pago y ahorrá hasta 33%."
>
  <Header />
  <main>
    <section id="licencias" class="section renew">
      <div class="container">
        <div class="center">
          <h1 class="section-title">Licencias extendidas</h1>
          <p class="section-sub">
            Contratá 6, 12 o 36 meses de una vez y ahorrá hasta 33%.<br /> Un solo pago, sin suscripciones mensuales.
          </p>
        </div>

        <div class="billing-toggle-wrap">
          <div class="billing-toggle" role="group" aria-label="Duración de la licencia">
            <button type="button" class="billing-option" data-months="6">6 meses <span class="billing-save">-10%</span></button>
            <button type="button" class="billing-option active" data-months="12">12 meses <span class="billing-save">-20%</span></button>
            <button type="button" class="billing-option" data-months="36">36 meses <span class="billing-save">-33%</span></button>
          </div>
        </div>

        <div class="plans">
          {plans.map((p) => (
            <article
              class:list={['plan', { featured: p.featured, preselected: p.key === highlighted }]}
              data-plan={p.key}
              data-monthly={p.monthly}
            >
              <span class:list={['plan-tag', { 'plan-tag--featured': p.featured }]}>{p.tag}</span>
              <h3 class="plan-name">{p.name}</h3>
              <p class="plan-desc">{p.desc}</p>
              <div class="plan-price">
                <span class="amount">{p.price}</span>
                <span class="per">{p.per}</span>
              </div>
              <div class="plan-save">
                <span class="save-original">{p.original}</span>
                <span class="save-badge">Ahorrás 20%</span>
              </div>
              <div class="plan-divider"></div>
              <ul class="plan-features">
                {p.features.map((f) => (
                  <li>
                    <svg class="check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                    <span class="feature-text">{f.strong && <strong>{f.strong}</strong>}{f.text}</span>
                  </li>
                ))}
              </ul>
              <button
                type="button"
                class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost', 'plan-btn']}
                data-plan={p.key}
              >
                {p.cta}
              </button>
            </article>
          ))}
        </div>

        <p class="renew-note">
          Tu licencia se activa al confirmar el pago y recibís tu clave por email.
        </p>
      </div>
    </section>
  </main>

  <CheckoutModal durationSelector=".billing-option.active" />

  <Footer />
</BaseLayout>

<script>
  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
  const DURATIONS = {
    6: { factor: 0.9, save: 'Ahorrás 10%' },
    12: { factor: 0.8, save: 'Ahorrás 20%' },
    36: { factor: 0.67, save: 'Ahorrás 33%' },
  };
  let durationMonths = 12;

  function updatePrices() {
    const { factor, save } = DURATIONS[durationMonths];
    document.querySelectorAll('[data-monthly]').forEach((article) => {
      const monthly = Number(article.dataset.monthly);
      if (!monthly) return;
      const amountEl = article.querySelector('.amount');
      const perEl = article.querySelector('.per');
      const originalEl = article.querySelector('.save-original');
      const badgeEl = article.querySelector('.save-badge');
      const original = monthly * durationMonths;
      const total = Math.round(original * factor);
      amountEl.textContent = `$${fmt.format(total)}`;
      perEl.textContent = `por ${durationMonths} meses`;
      originalEl.textContent = `$${fmt.format(original)}`;
      badgeEl.textContent = save;
    });
  }

  document.querySelectorAll('.billing-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      durationMonths = Number(btn.dataset.months);
      document.querySelectorAll('.billing-option').forEach((b) => b.classList.toggle('active', b === btn));
      updatePrices();
    });
  });
</script>

<style>
  .renew { background: var(--bg-alt); min-height: 70vh; }
  .renew .center .section-sub { margin: 0 auto; }
  .renew-note {
    margin-top: 28px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .billing-toggle-wrap { margin-top: 32px; text-align: center; }
  .billing-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px;
  }
  .billing-option {
    border: none;
    background: transparent;
    color: var(--text-2);
    font-weight: 600;
    font-size: 0.95rem;
    font-family: inherit;
    padding: 9px 20px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .billing-option.active { background: var(--btn-bg); color: var(--on-btn); }
  .billing-save {
    background: var(--btn-bg);
    color: var(--on-btn);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .billing-option.active .billing-save { background: var(--on-btn); color: var(--footer-bg); }
  .plans {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    align-items: stretch;
  }
  .plan {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
  }
  .plan.featured { border: 2px solid var(--link); }
  .plan.preselected { outline: 3px solid var(--link); outline-offset: 2px; }
  .plan-tag {
    align-self: flex-start;
    background: var(--bg-alt);
    color: var(--text-2);
    border: 1px solid var(--border);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .plan-tag--featured { background: var(--btn-bg); color: var(--on-btn); border: none; }
  .plan-name { font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
  .plan-desc { color: var(--text-2); font-size: 0.92rem; margin-bottom: 20px; }
  .plan-price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 8px; }
  .amount { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.02em; }
  .plan.featured .amount { position: relative; isolation: isolate; padding: 0 4px; box-decoration-break: clone; }
  .plan.featured .amount::before { content: ''; position: absolute; z-index: -1; left: 0; right: 0; bottom: 0; height: 0.18em; background: var(--tag); }
  :global([data-theme="dark"]) .plan.featured .amount::before { bottom: -0.08em; height: 0.08em; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .plan.featured .amount::before { bottom: -0.08em; height: 0.08em; } }
  .per { color: var(--text-2); font-size: 0.9rem; }
  .plan-save {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }
  .save-original { color: var(--text-2); text-decoration: line-through; font-size: 0.95rem; }
  .save-badge {
    background: var(--accent-tint);
    color: var(--link);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .plan-divider { height: 1px; background: var(--border); margin: 20px 0; }
  .plan-features { list-style: none; margin-bottom: 28px; flex: 1; }
  .plan-features li {
    padding: 10px 0;
    color: var(--text-2);
    font-size: 0.95rem;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .check { color: var(--ok); flex-shrink: 0; margin-top: 3px; }
  .feature-text strong { color: var(--text); font-weight: 700; }
  .plan-btn { width: 100%; }
  @media (max-width: 720px) {
    .plans { grid-template-columns: 1fr; max-width: 420px; }
    .billing-toggle {
      display: flex;
      flex-wrap: nowrap;
      justify-content: center;
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      padding: 4px;
      gap: 3px;
    }
    .billing-option {
      flex: 1;
      justify-content: center;
      white-space: nowrap;
      padding: 10px 6px;
      gap: 4px;
      font-size: 0.82rem;
    }
    .billing-save { font-size: 0.62rem; padding: 1px 5px; }
  }
</style>
