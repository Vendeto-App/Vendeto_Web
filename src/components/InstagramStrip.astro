---
import { Image } from 'astro:assets';
import post1 from '../assets/instagram/post-1.jpg';
import post2 from '../assets/instagram/post-2.jpg';
import post3 from '../assets/instagram/post-3.jpg';
import post4 from '../assets/instagram/post-4.jpg';
const profile = 'https://www.instagram.com/vendetoapp/';
const posts = [
  { src: post1, alt: 'Hay una forma mucho más simple de controlar ventas, stock y caja' },
  { src: post2, alt: 'La gestión simple para tu negocio' },
  { src: post3, alt: 'Nació de una necesidad real' },
  { src: post4, alt: 'Vendeto existe para que ningún comerciante tenga que depender de un cuaderno para saber qué stock le queda y cuánto le deben' },
];
---
<section class="section instagram">
  <div class="container">
    <h2 class="section-title">Seguinos en Instagram</h2>
    <p class="instagram-sub"><a href={profile} target="_blank" rel="noopener">@vendetoapp</a></p>
    <div class="posts">
      {posts.map((post) => (
        <a href={profile} target="_blank" rel="noopener" aria-label={`Ver en Instagram: ${post.alt}`}>
          <Image src={post.src} width={640} height={800} alt={post.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .instagram { background: var(--bg-alt); }
  .instagram-sub a { color: var(--link); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .posts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 32px; padding: 6px; }
  .posts a { display: block; min-width: 0; max-width: 426px; border-radius: 10px; }
  .posts img { display: block; width: 100%; height: auto; border-radius: 10px; }
  @media (min-width: 600px) and (max-width: 899px) { .posts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) {
    .posts { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
    .posts a { flex: 0 0 calc((100% - 16px) / 1.6); scroll-snap-align: start; }
  }
</style>
