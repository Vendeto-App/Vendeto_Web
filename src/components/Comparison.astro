---
const rows = [
  { label: 'Saber qué stock te queda', notebook: 'A ojo', vendeto: 'Al instante' },
  { label: 'Cerrar la caja', notebook: 'Sumando a mano', vendeto: 'Automático' },
  { label: 'Fiados', notebook: 'Anotados en papel', vendeto: 'Saldo por cliente' },
  { label: 'Lo más vendido', notebook: 'No sabés', vendeto: 'Reporte listo' },
];
---
<section class="section comparison">
  <div class="container">
    <h2 class="section-title">Cuaderno o Vendeto</h2>
    <div class="table-wrap" role="region" aria-label="Comparación de cuaderno o Excel con Vendeto" tabindex="0">
      <table>
        <caption>Comparación de cuaderno o Excel con Vendeto</caption>
        <thead><tr><th scope="col"><span class="sr-only">Tarea</span></th><th scope="col">Cuaderno / Excel</th><th scope="col" class="vendeto">Vendeto</th></tr></thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th><td>{row.notebook}</td>
              <td class="vendeto"><span class="result"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{row.vendeto}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .table-wrap { margin-top: 40px; overflow-x: auto; }
  table { width: 100%; min-width: 600px; border-collapse: collapse; text-align: left; }
  caption, .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  th, td { padding: 18px 20px; border-bottom: 1px solid var(--border); }
  th { color: var(--text); font-weight: 700; }
  td { color: var(--text-2); }
  .vendeto { background: var(--accent-tint); color: var(--text); }
  .result { display: flex; align-items: center; gap: 10px; }
  .result svg { flex: none; color: var(--ok); }
</style>
