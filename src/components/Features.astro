---
import { MERCADO_PAGO_PATH } from '../icons/mercadopago';

type FeatureItem = { title: string; description: string; icon?: string; brand?: 'mercadopago' };
type FeatureGroup = { title: string; items: FeatureItem[] };

const rawGroups: FeatureGroup[] = [
  {
    title: 'Cobrar',
    items: [
      { title: 'Ventas rápidas', description: 'Efectivo, débito, crédito, transferencia y QR.', icon: '<rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><path d="M6 14h2"/>' },
      { title: 'Productos por código de barras', description: 'Por unidad, kilo o litro, con categorías.', icon: '<path d="M3 5v14"/><path d="M8 5v14"/><path d="M12 5v14"/><path d="M17 5v14"/><path d="M21 5v14"/>' },
      { title: 'Clientes y fiado', description: 'Cuentas corrientes con el saldo de cada cliente.', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>' },
      { title: 'Cobros con Mercado Pago', description: 'Vinculás tu cuenta, mostrás el QR y el pago se verifica al instante. En el plan Avanzado.', brand: 'mercadopago' },
    ],
  },
  {
    title: 'Controlar',
    items: [
      { title: 'Stock al día', description: 'Se descuenta solo con cada venta, por producto y sucursal.', icon: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/>' },
      { title: 'Caja y gastos', description: 'Apertura, cierre y gastos registrados.', icon: '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>' },
      { title: 'Compras a proveedores', description: 'Registrás cada compra y el stock se actualiza.', icon: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>' },
    ],
  },
  {
    title: 'Crecer',
    items: [
      { title: 'Reportes', description: 'Lo más vendido y tus márgenes, al momento.', icon: '<path d="M13 17V9"/><path d="M18 17V5"/><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M8 17v-3"/>' },
      { title: 'Usuarios con permisos', description: 'Dueño y vendedores, cada uno con su acceso.', icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>' },
    ],
  },
];
let offset = 0;
const groups = rawGroups.map((group) => {
  const start = offset;
  offset += group.items.length;
  return { ...group, start };
});
---
<section id="features" class="section features" data-reveal>
  <div class="container">
    <h2 class="section-title">Todo lo del mostrador, en un solo programa</h2>
    <div class="groups">
      {groups.map((group, groupIndex) => (
        <div class="group" data-anim style={`--i:${groupIndex}`}>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item, index) => (
              <li>
                {item.brand === 'mercadopago' ? (
                  <svg style={`--i:${group.start + index}`} width="24" height="24" viewBox="0 0 24 24" fill="var(--mercadopago)" aria-hidden="true"><path d={MERCADO_PAGO_PATH} /></svg>
                ) : (
                  <svg style={`--i:${group.start + index}`} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                )}
                <div><strong>{item.title}</strong><p>{item.description}</p></div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { background: var(--bg); }
  .section-title { max-width: 24ch; }
  .groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 48px; }
  .group { border-top: 1px solid var(--border); padding-top: 24px; }
  .group h3 { font-size: 1.25rem; margin-bottom: 24px; }
  .group ul { list-style: none; display: grid; gap: 24px; }
  .group li { display: flex; align-items: flex-start; gap: 14px; }
  .group svg { flex: none; color: var(--link); }
  .group strong { display: block; color: var(--text); }
  .group p { color: var(--text-2); font-size: 0.95rem; margin-top: 4px; }
  @media (max-width: 720px) { .groups { grid-template-columns: 1fr; gap: 32px; } }
</style>
