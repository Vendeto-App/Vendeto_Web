---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark-white.png';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <Image src={wordmark} alt="Vendeto" width={wordmark.width} height={wordmark.height} class="footer-logo" />
      <p class="footer-slogan">Tu punto de venta, siempre a tu lado.</p>
      <p class="footer-desc">
        Sistema de punto de venta (POS) para comercios minoristas.
        Ventas, stock, clientes, cajas y deudas en un solo lugar.
      </p>
    </div>
    <div>
      <h4>Producto</h4>
      <ul>
        <li><a href="/#features">Funcionalidades</a></li>
        <li><a href="/#precios">Precios</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/licencias-largas">Licencias largas</a></li>
        <li><a href="/renovar">Renovar licencia</a></li>
      </ul>
    </div>
    <div>
      <h4>Contacto</h4>
      <ul>
        <li><a class="footer-contact-link" href="mailto:soporte@vendeto.com.ar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg>soporte@vendeto.com.ar</a></li>
        <li><a class="footer-contact-link" href="tel:+5491138663629"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" /></svg>+54 9 11 3866-3629</a></li>
        <li><a href="https://wa.me/5491138663629?text=Hola%2C%20quiero%20info%20sobre%20Vendeto" target="_blank" rel="noopener">WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    © {year} Vendeto. Todos los derechos reservados.
  </div>
</footer>

<style>
  .footer { background: var(--footer-bg); color: var(--footer-text); padding: 64px 0 0; }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  .footer-logo {
    height: 40px;
    width: auto;
    margin-bottom: 16px;
  }
  .footer-desc { color: var(--footer-text); font-size: 0.9rem; max-width: 300px; }
  .footer-slogan { color: var(--footer-text); font-weight: 600; margin-bottom: 12px; }
  .footer h4 { color: var(--on-btn); font-size: 0.95rem; margin-bottom: 16px; }
  .footer ul { list-style: none; }
  .footer li { margin-bottom: 10px; }
  .footer li a { color: var(--footer-text); font-size: 0.9rem; }
  .footer li .footer-contact-link { display: inline-flex; align-items: center; gap: 8px; }
  .footer li a:hover { color: var(--on-btn); }
  .footer-bottom {
    border-top: 1px solid var(--footer-text);
    padding: 24px 0;
    color: var(--footer-text);
    font-size: 0.85rem;
  }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
