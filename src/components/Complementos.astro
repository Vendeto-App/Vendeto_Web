---
import { Image } from 'astro:assets';
import scanner from '../assets/photos/scanner.jpg';
const addons = [
  {
    icon: 'scan',
    name: 'Barcode Scanner',
    desc: 'Complemento de Vendeto que permite usar el celular como lector de códigos de barras.',
    url: 'https://drive.google.com/uc?export=download&id=14uXG1XVASh58nyyJ4O2YXnXX02ufwQL4',
  },
  {
    icon: 'search',
    name: 'Consulta Producto',
    desc: 'Complemento de Vendeto que permite consultar el stock, costo de venta y costo de compra desde el celular.',
    url: 'https://drive.google.com/uc?export=download&id=13z_AEyZw55spJuHBWIu0eCEIAXm9pUz7',
  },
];
---
<section id="complementos" class="section">
  <div class="container">
    <div class="center">
      <h2 class="section-title">Extendé las capacidades de Vendeto</h2>
      <p class="section-sub">
        Descargá los programas complementarios para potenciar tu punto de venta.
      </p>
    </div>

    <div class="addons-layout">
      <Image src={scanner} width={560} height={500} alt="Lector de códigos de barras escaneando una caja" loading="lazy" decoding="async" class="scanner-photo" />
    <div class="addons">
      {addons.map((a) => (
        <article class="addon-card">
          <div class="addon-icon">
            {a.icon === 'scan' ? (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2" /><path d="M17 3h2a2 2 0 0 1 2 2v2" /><path d="M21 17v2a2 2 0 0 1-2 2h-2" /><path d="M7 21H5a2 2 0 0 1-2-2v-2" /><path d="M8 7v10" /><path d="M12 7v10" /><path d="M17 7v10" /></svg>
            ) : (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" /></svg>
            )}
          </div>
          <h3 class="addon-name">{a.name}</h3>
          <p class="addon-desc">{a.desc}</p>
          <a href={a.url} class="btn btn-primary addon-btn" target="_blank" rel="noopener">
            Descargar
          </a>
        </article>
      ))}
    </div>
    </div>
  </div>
</section>

<style>
  .addons-layout {
    margin-top: 56px;
    display: grid;
    gap: 32px;
  }
  .scanner-photo { display: block; width: 100%; max-width: 373px; height: auto; border-radius: 14px; }
  .addons { display: grid; gap: 24px; min-width: 0; }
  .addon-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px;
    text-align: center;
  }
  .addon-icon { color: var(--link); margin-bottom: 14px; }
  .addon-name { font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; }
  .addon-desc { color: var(--text-2); font-size: 0.95rem; margin-bottom: 24px; }
  .addon-btn { width: 100%; }
  @media (min-width: 900px) { .addons-layout { grid-template-columns: minmax(0, 373px) minmax(0, 1fr); align-items: start; gap: 48px; } }
</style>
