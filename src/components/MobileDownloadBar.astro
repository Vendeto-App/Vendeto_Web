<a href="/api/latest?download=1" class="mobile-dl" data-mobile-dl hidden>Descargar gratis · 30 días</a>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-mobile-dl]');
    var hero = document.getElementById('inicio');
    var contact = document.getElementById('contacto');
    if (!bar || !hero || !contact || !('IntersectionObserver' in window)) return;

    var heroVisible = true;
    var showState = false;
    var hideTimer;
    var ticking = false;

    function contactReached() {
      return contact.getBoundingClientRect().top <= window.innerHeight;
    }

    function sync() {
      var show = !heroVisible && !contactReached();
      if (show === showState) return;
      showState = show;
      clearTimeout(hideTimer);
      if (show) {
        bar.hidden = false;
        requestAnimationFrame(function () {
          if (showState) bar.classList.add('is-visible');
        });
      } else {
        bar.classList.remove('is-visible');
        hideTimer = setTimeout(function () {
          if (!showState) bar.hidden = true;
        }, 250);
      }
    }

    new IntersectionObserver(function (entries) {
      heroVisible = entries[0].isIntersecting;
      sync();
    }).observe(hero);

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        sync();
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  })();
</script>

