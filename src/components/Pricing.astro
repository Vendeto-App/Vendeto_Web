---
import CheckoutModal from './CheckoutModal.astro';
import MercadoPagoIcon from './MercadoPagoIcon.astro';
import TrialDays from './TrialDays.astro';
import { TRIAL_PROMO } from '../config';
const plans = [
  {
    name: 'Gratuito',
    key: 'gratuito',
    tag: 'Ideal para probar',
    price: '$0',
    per: 'al vencer la prueba',
    desc: 'Seguí usando Vendeto gratis, con lo esencial para tu día a día.',
    features: [
      { strong: '1 solo usuario', text: ' con acceso completo' },
      { strong: 'Hasta 500 productos', text: ' en catálogo' },
      { strong: '+140.000 productos', text: ' precargados' },
      { text: 'Control de ventas, caja y stock' },
    ],
    cta: 'Empezar gratis',
    featured: false,
  },
  {
    name: 'Básico',
    key: 'basica',
    tag: 'El más elegido',
    price: '$32.500',
    per: '/ mes',
    desc: 'Para comercios que arrancan y necesitan todas las funciones.',
    includes: 'Incluye todo lo del plan Gratuito, más:',
    features: [
      { strong: 'Hasta 3 usuarios', text: ' trabajando en equipo' },
      { strong: 'Hasta 1.000 productos', text: ' en catálogo' },
      { text: 'Todos los módulos activados' },
      { text: 'Soporte por email y WhatsApp' },
    ],
    cta: 'Elegir Básico',
    featured: false,
  },
  {
    name: 'Avanzado',
    key: 'maxima',
    tag: 'El más completo',
    price: '$39.990',
    per: '/ mes',
    desc: 'Todo el poder de Vendeto, sin límites de usuarios ni de productos.',
    includes: 'Incluye todo lo del plan Básico, más:',
    features: [
      { strong: 'Usuarios ilimitados' },
      { strong: 'Hasta 10.000 productos', text: ' en catálogo' },
      { text: 'Verificación instantánea de pagos con Mercado Pago' },
      { text: 'Soporte prioritario por email y WhatsApp' },
    ],
    cta: 'Elegir Avanzado',
    featured: true,
  },
];
---
<section id="precios" class="section pricing" data-reveal>
  <div class="container">
    <div class="center">
      <h2 class="section-title">Precios</h2>
      <p class="section-sub">
        Empezá gratis y pasate a un plan pago cuando lo necesites.
      </p>
    </div>

    <div class="trial-banner" data-anim style="--i:0">
      <span class="trial-badge">{TRIAL_PROMO ? TRIAL_PROMO.label : 'Prueba gratuita'}</span>
      <p class="trial-text">Probá el plan <strong>Avanzado</strong> gratis durante <TrialDays animate />.</p>
    </div>

    <div class="plans">
      {plans.map((p, planIndex) => (
        <article class:list={['plan', { featured: p.featured }]} data-anim style={`--i:${planIndex + 1}`}>
          <span class:list={['plan-tag', { 'plan-tag--featured': p.featured }]}>{p.tag}</span>
          <h3 class="plan-name">{p.name}</h3>
          <p class="plan-desc">{p.desc}</p>
          <div class="plan-price">
            <span class="amount">{p.price}</span>
            <span class="per">{p.per}</span>
          </div>
          {p.key !== 'gratuito' && <p class="plan-billing-note">Débito automático o pago mensual</p>}
          <div class="plan-divider"></div>
          {p.includes && (
            <div class="plan-includes">
              <span class="includes-line"></span>
              <p class="includes-text">{p.includes}</p>
            </div>
          )}
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <svg class="check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7" />
                </svg>
                <span class="feature-text">{f.strong && <strong>{f.strong}</strong>}{f.text}{f.text === 'Verificación instantánea de pagos con Mercado Pago' && <> <MercadoPagoIcon /></>}</span>
              </li>
            ))}
          </ul>
          {p.key === 'gratuito' ? (
            <a href="/api/latest?download=1" class:list={['btn', 'btn-ghost', 'plan-btn']}>
              Descargar gratis
            </a>
          ) : (
            <button
              type="button"
              class:list={['btn', p.featured ? 'btn-primary' : 'btn-ghost', 'plan-btn']}
              data-plan={p.key}
              data-price={p.price}
            >
              {p.cta}
            </button>
          )}
        </article>
      ))}
    </div>

    <div class="one-time-banner" data-anim style={`--i:${plans.length + 1}`}>
      <p class="one-time-text">
        <strong>¿Cansado de las suscripciones?</strong> Revisá nuestras licencias extendidas:
      </p>
      <a href="/licencias-largas" class="btn btn-one-time">Ver licencias extendidas</a>
    </div>
  </div>

  <CheckoutModal billingChoice />
</section>

<style>
  .pricing { background: var(--bg-alt); }
  .trial-banner {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--btn-bg);
    color: var(--on-btn);
    border-radius: 14px;
    padding: 18px 24px;
  }
  .trial-badge {
    background: var(--on-btn);
    color: var(--footer-bg);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: 999px;
  }
  .trial-text { font-size: 1.05rem; }
  .trial-text strong { font-weight: 800; }
  .one-time-banner {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    text-align: center;
    background: var(--surface);
    border: 2px solid var(--link);
    border-radius: 14px;
    padding: 22px 28px;
  }
  .one-time-text { font-size: 1.05rem; color: var(--text-2); }
  .one-time-text strong { font-weight: 800; color: var(--text); }
  .btn-one-time {
    background: var(--btn-bg);
    color: var(--on-btn);
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 700;
  }
  .btn-one-time:hover { background: var(--btn-bg-hover); }
  .plans {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .plan {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
  }
  .plan.featured {
    border: 2px solid var(--link);
  }
  .plan-tag {
    align-self: flex-start;
    background: var(--bg-alt);
    color: var(--text-2);
    border: 1px solid var(--border);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .plan-tag--featured {
    background: var(--btn-bg);
    color: var(--on-btn);
    border: none;
  }
  .plan-name { font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
  .plan-desc { color: var(--text-2); font-size: 0.92rem; margin-bottom: 20px; }
  .plan-price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 8px; }
  .amount { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.02em; }
  .plan.featured .amount { position: relative; isolation: isolate; padding: 0 4px; box-decoration-break: clone; }
  .plan.featured .amount::before { content: ''; position: absolute; z-index: -1; left: 0; right: 0; bottom: 0; height: 0.18em; background: var(--tag); }
  :global([data-theme="dark"]) .plan.featured .amount::before { bottom: -0.08em; height: 0.08em; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .plan.featured .amount::before { bottom: -0.08em; height: 0.08em; } }
  .per { color: var(--text-2); font-size: 0.9rem; }
  .plan-billing-note { color: var(--text-3); font-size: 0.85rem; }
  .plan-divider { height: 1px; background: var(--border); margin: 20px 0; }
  .plan-includes {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 18px 0 4px;
  }
  .includes-line { flex: 1; height: 1px; background: var(--border); }
  .includes-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    white-space: nowrap;
  }
  .plan-features { list-style: none; margin-bottom: 28px; flex: 1; }
  .plan-features li {
    padding: 10px 0;
    color: var(--text-2);
    font-size: 0.95rem;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .check {
    color: var(--ok);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .feature-text strong { color: var(--text); font-weight: 700; }
  .plan-btn { width: 100%; }
  @media (max-width: 900px) { .plans { grid-template-columns: 1fr; max-width: 420px; margin-left: auto; margin-right: auto; } }
</style>
