---
const CONTACT_URL = 'https://posweb-mailer.chiacchio-eze01.workers.dev/contact';
---

<section id="contacto" class="section contact" data-reveal>
  <div class="container contact-grid">
    <div class="contact-copy" data-anim style="--i:0">
      <h2 class="section-title">¿Tenés una consulta?</h2>
      <p class="section-sub">
        Dejanos tu nombre, tu email y tu consulta. Te respondemos a la brevedad.
      </p>
      <ul class="contact-links">
        <li><a class="contact-link" href="https://wa.me/5491138663629?text=Hola%2C%20quiero%20info%20sobre%20Vendeto" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>Escribinos por WhatsApp</a></li>
        <li><a class="contact-link" href="mailto:soporte@vendeto.com.ar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg>soporte@vendeto.com.ar</a></li>
        <li><a class="contact-link" href="tel:+5491138663629"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" /></svg>+54 9 11 3866-3629</a></li>
      </ul>
    </div>

    <form class="contact-form" data-contact-form data-anim style="--i:1">
      <div class="field">
        <label for="contact-nombre">Nombre</label>
        <input id="contact-nombre" name="nombre" type="text" maxlength="100" required autocomplete="name" placeholder="Tu nombre" />
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" />
      </div>
      <div class="field">
        <label for="contact-consulta">Consulta</label>
        <textarea id="contact-consulta" name="consulta" rows="5" minlength="10" maxlength="2000" required placeholder="Contanos en qué podemos ayudarte"></textarea>
      </div>
      <button type="submit" class="btn btn-primary contact-submit" data-contact-submit>Enviar consulta</button>
      <p class="contact-status" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script define:vars={{ CONTACT_URL }}>
  const form = document.querySelector('[data-contact-form]');
  const submit = form?.querySelector('[data-contact-submit]');
  const status = form?.querySelector('[data-contact-status]');

  function setStatus(message, kind = '') {
    if (!status) return;
    status.textContent = message;
    status.className = 'contact-status' + (kind ? ' contact-status-' + kind : '');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submit) return;

    const nombre = form.nombre.value.trim();
    const email = form.email.value.trim();
    const consulta = form.consulta.value.trim();

    if (!nombre || !email || !consulta) {
      setStatus('Completá todos los campos.', 'error');
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Enviando...';
    setStatus('');

    try {
      const res = await fetch(CONTACT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, email, consulta }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'No se pudo enviar la consulta');
      form.reset();
      setStatus('¡Consulta enviada! Te respondemos a la brevedad.', 'success');
    } catch (err) {
      setStatus(err.message || 'Ocurrió un error. Intentá de nuevo.', 'error');
    } finally {
      submit.disabled = false;
      submit.textContent = 'Enviar consulta';
    }
  });
</script>

<style>
  .contact { background: var(--bg); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .contact-links {
    list-style: none;
    margin-top: 24px;
  }
  .contact-links li { margin-bottom: 12px; }
  .contact-links a {
    color: var(--link);
    font-weight: 600;
  }
  .contact-links a:hover { text-decoration: underline; }
  .contact-links .contact-link { display: inline-flex; align-items: center; gap: 8px; }
  .contact-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px;
  }
  .field { margin-bottom: 20px; }
  .field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 8px;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--text);
    background: var(--surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--link);
    background: var(--surface);
  }
  .field textarea { resize: vertical; }
  .contact-submit { width: 100%; }
  .contact-status { margin-top: 16px; font-size: 0.9rem; }
  .contact-status-success { color: var(--ok); }
  .contact-status-error { color: var(--danger); }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
